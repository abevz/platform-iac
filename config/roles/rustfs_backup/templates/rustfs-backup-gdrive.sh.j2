#!/bin/bash
set -euo pipefail

RCLONE_SOURCE="{{ rustfs_backup_rclone_source }}"
RCLONE_TARGET="{{ rustfs_backup_rclone_target }}"
RCLONE_CONFIG="{{ rustfs_backup_rclone_config_file }}"

log() { echo "[$(date --iso-8601=seconds)] rustfs-backup: $*"; }

log "Starting RustFS → GDrive encrypted sync"
log "Source: ${RCLONE_SOURCE}  Target: ${RCLONE_TARGET}"

# Copy retains backup objects removed from the source.
rclone copy \
  --config "$RCLONE_CONFIG" \
  --transfers 4 \
  --checkers 8 \
  --retries 3 \
  --log-level INFO \
  "${RCLONE_SOURCE}" \
  "${RCLONE_TARGET}"

log "RustFS sync completed"
