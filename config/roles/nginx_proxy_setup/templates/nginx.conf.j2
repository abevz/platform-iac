# /config/roles/nginx_proxy_setup/templates/nginx.conf.j2
# File managed by Ansible. DO NOT EDIT MANUALLY.
user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

stream {
    map $ssl_preread_server_name $backend_stream {
        ~^(.*)\.k8s\.{{ primary_domain | default("<your-domain>.com") }}$  {{ nginx_proxy_upstreams.k8s_ingress }};
        default                 127.0.0.1:1443;
    }

    server {
        listen 443;
        listen [::]:443;

        proxy_pass $backend_stream;
        ssl_preread on;
        proxy_protocol on;
    }

    server {
        listen 2222;
        proxy_pass {{ nginx_proxy_upstreams.gitlab_ssh }};
        proxy_timeout 3600s;
        proxy_connect_timeout 60s;
    }
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # The stream block terminates external connections and relays them to
    # 127.0.0.1:1443 wrapped in a PROXY protocol header carrying the real
    # client address. Without this, $remote_addr here would be 127.0.0.1
    # for every request, defeating any allow/deny IP restrictions below.
    real_ip_header proxy_protocol;
    set_real_ip_from 127.0.0.1;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    tcp_nopush      on;
    keepalive_timeout  65;

    # These snippets are global HTTP defaults. TLS settings stay per-vhost so
    # upstream HSTS can be hidden and the edge sends one canonical value.
    include /etc/nginx/conf.d/gzip.conf;
    include /etc/nginx/conf.d/proxy-params-websockets.conf;
    include /etc/nginx/conf.d/default.conf;
}
