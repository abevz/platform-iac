# /config/roles/nginx_proxy_setup/templates/default.conf.j2
# File managed by Ansible. DO NOT EDIT MANUALLY.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 127.0.0.1:1443 ssl http2 proxy_protocol default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 80;
    listen [::]:80;
    server_name harbor.{{ primary_domain | default("<your-domain>.com") }} gitlab.{{ primary_domain | default("<your-domain>.com") }} s3.minio.{{ primary_domain | default("<your-domain>.com") }} minio.{{ primary_domain | default("<your-domain>.com") }} grafana.{{ primary_domain | default("<your-domain>.com") }} jenkins.{{ primary_domain | default("<your-domain>.com") }} vault.{{ primary_domain | default("<your-domain>.com") }};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 127.0.0.1:1443 ssl http2 proxy_protocol;
    server_name gitlab.{{ primary_domain | default("<your-domain>.com") }};

    ssl_certificate /etc/letsencrypt/live/{{ primary_domain | default("<your-domain>.com") | replace('.', '-') }}-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ primary_domain | default("<your-domain>.com") | replace('.', '-') }}-wildcard/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/{{ primary_domain | default("<your-domain>.com") | replace('.', '-') }}-wildcard/chain.pem;
    include /etc/nginx/conf.d/ssl-params.conf;

    location / {
        proxy_pass http://{{ nginx_proxy_upstreams.gitlab_http }};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
    }
}

server {
    listen 127.0.0.1:1443 ssl http2 proxy_protocol;
    server_name s3.minio.{{ primary_domain | default("<your-domain>.com") }};

    ssl_certificate /etc/letsencrypt/live/s3-minio-{{ primary_domain | default("<your-domain>.com") | replace('.', '-') }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/s3-minio-{{ primary_domain | default("<your-domain>.com") | replace('.', '-') }}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/s3-minio-{{ primary_domain | default("<your-domain>.com") | replace('.', '-') }}/chain.pem;
    include /etc/nginx/conf.d/ssl-params.conf;

    client_max_body_size 0;

    location / {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 300;
        proxy_send_timeout 300;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass {{ nginx_proxy_upstreams.minio_s3_api }};
    }
}

server {
    listen 127.0.0.1:1443 ssl http2 proxy_protocol;
    server_name minio.{{ primary_domain | default("<your-domain>.com") }};

    ssl_certificate /etc/letsencrypt/live/{{ primary_domain | default("<your-domain>.com") | replace('.', '-') }}-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ primary_domain | default("<your-domain>.com") | replace('.', '-') }}-wildcard/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/{{ primary_domain | default("<your-domain>.com") | replace('.', '-') }}-wildcard/chain.pem;
    include /etc/nginx/conf.d/ssl-params.conf;
    location / {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
