}

server {
    listen 127.0.0.1:1443 ssl http2 proxy_protocol;
    server_name harbor.{{ primary_domain | default("<your-domain>.com") }};

    ssl_certificate /etc/letsencrypt/live/{{ primary_domain | default("<your-domain>.com") | replace('.', '-') }}-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ primary_domain | default("<your-domain>.com") | replace('.', '-') }}-wildcard/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/{{ primary_domain | default("<your-domain>.com") | replace('.', '-') }}-wildcard/chain.pem;
    include /etc/nginx/conf.d/ssl-params.conf;
    client_max_body_size 0;

    location / {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 600;
        proxy_send_timeout 600;
        proxy_read_timeout 600;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_pass http://{{ nginx_proxy_upstreams.harbor_http }};
    }
}

server {
    listen 127.0.0.1:1443 ssl http2 proxy_protocol;
    server_name vault.{{ primary_domain | default("<your-domain>.com") }};

    ssl_certificate /etc/letsencrypt/live/{{ primary_domain | default("<your-domain>.com") | replace('.', '-') }}-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ primary_domain | default("<your-domain>.com") | replace('.', '-') }}-wildcard/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/{{ primary_domain | default("<your-domain>.com") | replace('.', '-') }}-wildcard/chain.pem;
    include /etc/nginx/conf.d/ssl-params.conf;

    allow 10.10.10.0/24;
    deny all;

    location / {
        proxy_pass {{ nginx_proxy_upstreams.vault_http }};
        proxy_ssl_name vault.{{ primary_domain | default("<your-domain>.com") }};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

